# 실제 키는 .env 에 작성하세요 (.env 는 git 에서 제외됩니다)

# LLM
ANTHROPIC_API_KEY=

# 트렌드 수집
YOUTUBE_API_KEY=

# 웹 조사 (settings.yaml research.provider 가 tavily/serper 일 때만)
TAVILY_API_KEY=
SERPER_API_KEY=

# TTS
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=   # Google Cloud TTS 서비스 계정 JSON 경로

# 스톡 비주얼
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 알림 (선택)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 업로드 (선택, Phase 7)
YOUTUBE_OAUTH_CLIENT_SECRETS=config/client_secret.json
YOUTUBE_OAUTH_TOKEN=data/youtube_token.json
