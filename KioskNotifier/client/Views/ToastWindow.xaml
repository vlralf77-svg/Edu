<Window x:Class="KioskNotifier.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="360" Height="112"
        Focusable="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="10" Background="#FFFFFF"
            BorderBrush="#22000000" BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
            </Grid.RowDefinitions>

            <Grid Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar" Grid.Column="0" Width="6" CornerRadius="3"
                        Background="#3DB25B" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TypeText" Text="도착 알림"
                               FontSize="12" FontWeight="SemiBold" Foreground="#3DB25B"/>
                    <TextBlock x:Name="TitleText" Text="홍길동 (12345678)"
                               FontSize="16" FontWeight="Bold" Foreground="#222" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="접수 시각: 10:23:04"
                               FontSize="12" Foreground="#666" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="CloseBtn" Grid.Column="3"
                        Content="×" FontSize="16"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#888"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Click="CloseBtn_Click" Cursor="Hand"/>
            </Grid>

            <Border Grid.Row="1" Background="#EEE" CornerRadius="0,0,10,10">
                <Border x:Name="CountdownFill" Background="#3DB25B" HorizontalAlignment="Left"
                        Width="360" CornerRadius="0,0,0,10"/>
            </Border>
        </Grid>
    </Border>
</Window>
