<Window x:Class="KioskNotifier.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="키오스크 알림 · 진료실 설정"
        Width="460" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="이 PC를 어느 진료실로 지정할지 입력하세요."
                   FontSize="13" Foreground="#555" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="PC ID" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="PcIdBox" IsReadOnly="True" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hostname" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="2" Grid.Column="1" x:Name="HostBox" IsReadOnly="True" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="IP 주소" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="3" Grid.Column="1" x:Name="IpBox" IsReadOnly="True" Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="진료실 코드" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="4" Grid.Column="1" x:Name="RoomCdBox" Margin="0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="진료실명" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="5" Grid.Column="1" x:Name="RoomNmBox" Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="담당의사" VerticalAlignment="Center"/>
        <TextBox  Grid.Row="6" Grid.Column="1" x:Name="DoctorBox" Margin="0,4"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="소리 알림" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="SoundChk" Content="사용" Margin="0,4"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="자동 시작" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="AutoStartChk" Content="Windows 시작 시 실행" Margin="0,4"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="취소" Width="90" Height="32" Margin="0,0,8,0" Click="CancelBtn_Click"/>
            <Button x:Name="SaveBtn"   Content="저장" Width="90" Height="32" Click="SaveBtn_Click"
                    Background="#3DB25B" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
